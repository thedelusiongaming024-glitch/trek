# Neon / PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Secret key for signing session tokens (generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-strong-random-64-character-hex-secret"

# Allowed CORS origins (comma-separated, optional; defaults to same-origin)
ALLOWED_ORIGINS="http://localhost:3000"

# Google Gemini API Key for AI support chat and RAG knowledge chunking
GEMINI_API_KEY="your_gemini_api_key_here"

# Resend API Key for transactional email delivery (OTP verification & newsletters)
# Can also be configured directly in Admin Panel -> Newsletter -> Email Sender Settings
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Trek Consultancy Forum <onboarding@resend.dev>"
