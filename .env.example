# Neon / PostgreSQL Database URL
DATABASE_URL="your-neon-postgres-connection-string"

# Google Gemini API Key — used by the AI support chat pipeline (src/server/pipeline.ts).
# Get a real key from https://aistudio.google.com/apikey — it must start with "AIzaSy...".
# Note: as of late 2026, Google is migrating AI Studio to "AQ."-prefixed auth keys, which
# are currently rejected by generativelanguage.googleapis.com (401 ACCESS_TOKEN_TYPE_UNSUPPORTED).
# If your key comes out as AQ.-prefixed and requests fail, try generating one via Google Cloud
# Console → APIs & Services → Credentials instead, or watch https://discuss.ai.google.dev for updates.
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI API Key — used by the admin "AI Document & Knowledge Ingestion" file-extraction
# endpoint (knowledge-docs/extract-from-file). Get one from https://platform.openai.com/api-keys.
OPENAI_API_KEY="your-openai-api-key"
